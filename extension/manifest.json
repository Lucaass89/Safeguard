{
  "manifest_version": 3,
  "name": "SafeLink",
  "description": "Avisa con un color si la pestaña activa parece riesgosa. No bloquea la navegación. Las páginas en verde no salen de tu compu.",
  "version": "0.4.3",
  "action": {
    "default_title": "SafeLink",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "storage", "notifications"],
  "host_permissions": ["https://axbwxsghgxcqhjxckqcp.supabase.co/*"]
}
